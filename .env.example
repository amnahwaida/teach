# Token untuk Cloudflare Tunnel
# Dapatkan token ini saat membuat tunnel baru di Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=eyJhIjoi... (paste token Anda di sini)

# Rahasia untuk mengenkripsi JSON Web Token (JWT)
# Pastikan untuk mengganti ini dengan string acak yang kuat di VPS Anda
JWT_SECRET=rahasia-jwt-sangat-kuat-untuk-produksi-123!

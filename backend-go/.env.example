# ===== WAJIB (compose akan gagal bila tidak disetel) =====

# Password user PostgreSQL 'ajar' (ganti dengan nilai kuat!)
DB_PASSWORD=ganti-password-database!

# Email super admin (akun dibuat otomatis saat pertama kali start)
ADMIN_EMAIL=admin@ajar.in

# Password super admin (ganti!; tidak sync otomatis dengan DB)
ADMIN_PASSWORD=ganti-password-ini!

# ===== Opsional =====

# Koneksi PostgreSQL langsung (tanpa compose)
# DATABASE_URL=postgres://ajar:ganti-password-database!@localhost:5432/ajar?sslmode=disable

# Port server
PORT=3000

# URL publik aplikasi (dipakai untuk cookie Secure saat HTTPS via Cloudflare)
APP_URL=https://ajar.my-vps.com

# Token untuk Cloudflare Tunnel (opsional, untuk compose)
TUNNEL_TOKEN=
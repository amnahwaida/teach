# Koneksi PostgreSQL
DATABASE_URL=postgres://ajar:ajar@localhost:5432/ajar?sslmode=disable

# Port server
PORT=3000

# Rahasia sesi tidak diperlukan terpisah (session token random), tapi pastikan:
# ADMIN_EMAIL berisi email super admin yang akan dibuat otomatis saat pertama kali start
ADMIN_EMAIL=admin@ajar.in
ADMIN_PASSWORD=ganti-password-ini!

# URL publik aplikasi (dipakai untuk cookie Secure saat HTTPS via Cloudflare)
APP_URL=https://ajar.my-vps.com

# Token untuk Cloudflare Tunnel (opsional, untuk compose)
TUNNEL_TOKEN=